# GitHub Pages: the repository path the site is served from.
NEXT_PUBLIC_BASE_PATH=/portfolio

# Absolute origin, used for canonical URLs, hreflang, sitemap and OG tags.
NEXT_PUBLIC_ORIGIN=https://matheusPavaneli.github.io

# Formspree form id. Unset, the contact form renders its mail fallback instead.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
